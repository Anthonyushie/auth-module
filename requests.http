### Variables
@baseUrl = http://localhost:5000/api/auth
@articlesUrl = http://localhost:5000/api/articles
@paymentsUrl = http://localhost:5000/api/payments
@userEmail = user@example.com
@adminEmail = admin@example.com
@password = Password123!

### 1. Health Check
GET http://localhost:5000/health

### 2. Register Regular User
# @name registerUser
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{password}}",
  "role": "user"
}

### 3. Register Admin User
# @name registerAdmin
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}",
  "role": "admin"
}

### 4. Login as User (Receives Access Token & HTTP-Only Refresh Cookie)
# @name loginUser
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{password}}"
}

### Store User Access Token from Login Response
@userAccessToken = {{loginUser.response.body.data.accessToken}}

### 5. Login as Admin
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}"
}

### Store Admin Access Token
@adminAccessToken = {{loginAdmin.response.body.data.accessToken}}

### 6. Access Profile (Protected Route - User Token)
GET {{baseUrl}}/profile
Authorization: Bearer {{userAccessToken}}

### 7. Access Admin Dashboard as User (Expected: 403 Forbidden)
GET {{baseUrl}}/admin-dashboard
Authorization: Bearer {{userAccessToken}}

### 8. Access Admin Dashboard as Admin (Expected: 200 OK)
GET {{baseUrl}}/admin-dashboard
Authorization: Bearer {{adminAccessToken}}

### 9. Refresh Token Rotation (Uses HTTP-Only Cookie automatically)
# @name refreshToken
POST {{baseUrl}}/refresh

### Store New Access Token
@newAccessToken = {{refreshToken.response.body.data.accessToken}}

### 10. Access Profile with New Rotated Access Token
GET {{baseUrl}}/profile
Authorization: Bearer {{newAccessToken}}

### 11. List Articles as User (titles/metadata only, no body)
GET {{articlesUrl}}?status=published
Authorization: Bearer {{userAccessToken}}

### 12. Read Article Detail as User without Sub (Expected: 402 PAYMENT_REQUIRED)
GET {{articlesUrl}}/some-article-slug
Authorization: Bearer {{userAccessToken}}

### 13. Create Article as Admin (Expected: 201)
# @name createArticle
POST {{articlesUrl}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "title": "Why Subscriptions Beat One-Off Sales",
  "body": "This is a long-form article body with at least fifty characters to pass validation. Medium-style paid content lives here.",
  "status": "Published"
}

### Store Created Article ID + Slug
@articleId = {{createArticle.response.body.data.id}}
@articleSlug = {{createArticle.response.body.data.slug}}

### 14. Create Article as User (Expected: 403)
POST {{articlesUrl}}
Authorization: Bearer {{userAccessToken}}
Content-Type: application/json

{
  "title": "Should Fail",
  "body": "This body is long enough to pass validation but the role check must reject it with 403 Forbidden."
}

### 15. Update Article as Admin
PUT {{articlesUrl}}/{{articleId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "title": "Why Subscriptions Beat One-Off Sales (Updated)"
}

### 16. Start Checkout as User (returns Flutterwave paymentLink)
# @name checkout
POST {{paymentsUrl}}/checkout
Authorization: Bearer {{userAccessToken}}

### 17. Check Subscription Status
GET {{paymentsUrl}}/status
Authorization: Bearer {{userAccessToken}}

### 18. Verify Payment after Flutterwave redirect (fill ids from callback)
GET {{paymentsUrl}}/verify?transaction_id=1234567890&tx_ref={{checkout.response.body.data.txRef}}
Authorization: Bearer {{userAccessToken}}

### 19. Delete Article as Admin
DELETE {{articlesUrl}}/{{articleId}}
Authorization: Bearer {{adminAccessToken}}

### 20. Logout
POST {{baseUrl}}/logout
