### Variables
@baseUrl = http://localhost:5000/api/auth
@tasksUrl = http://localhost:5000/api/tasks
@userEmail = user@example.com
@adminEmail = admin@example.com
@password = Password123!

### 1. Health Check
GET http://localhost:5000/health

### 2. Register Regular User
# @name registerUser
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{password}}",
  "role": "user"
}

### 3. Register Admin User
# @name registerAdmin
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}",
  "role": "admin"
}

### 4. Login as User (Receives Access Token & HTTP-Only Refresh Cookie)
# @name loginUser
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{password}}"
}

### Store User Access Token from Login Response
@userAccessToken = {{loginUser.response.body.data.accessToken}}

### 5. Login as Admin
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}"
}

### Store Admin Access Token
@adminAccessToken = {{loginAdmin.response.body.data.accessToken}}

### 6. Access Profile (Protected Route - User Token)
GET {{baseUrl}}/profile
Authorization: Bearer {{userAccessToken}}

### 7. Access Admin Dashboard as User (Expected: 403 Forbidden)
GET {{baseUrl}}/admin-dashboard
Authorization: Bearer {{userAccessToken}}

### 8. Access Admin Dashboard as Admin (Expected: 200 OK)
GET {{baseUrl}}/admin-dashboard
Authorization: Bearer {{adminAccessToken}}

### 9. Refresh Token Rotation (Uses HTTP-Only Cookie automatically)
# @name refreshToken
POST {{baseUrl}}/refresh

### Store New Access Token
@newAccessToken = {{refreshToken.response.body.data.accessToken}}

### 10. Access Profile with New Rotated Access Token
GET {{baseUrl}}/profile
Authorization: Bearer {{newAccessToken}}

### 11. Create a Task (Protected - Uses user access token)
# @name createTask
POST {{tasksUrl}}
Authorization: Bearer {{userAccessToken}}
Content-Type: application/json

{
  "title": "Build a secure REST API with TypeScript"
}

### Store Created Task ID
@taskId = {{createTask.response.body.data.id}}

### 12. Get All Tasks for Authenticated User
GET {{tasksUrl}}
Authorization: Bearer {{userAccessToken}}

### 13. Update Task (Toggle completed and edit title)
PUT {{tasksUrl}}/{{taskId}}
Authorization: Bearer {{userAccessToken}}
Content-Type: application/json

{
  "title": "Build a secure REST API with TypeScript (Completed!)",
  "completed": true
}

### 14. Delete Task
DELETE {{tasksUrl}}/{{taskId}}
Authorization: Bearer {{userAccessToken}}

### 15. Logout
POST {{baseUrl}}/logout
