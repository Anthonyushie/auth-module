{
  "name": "auth-module",
  "version": "1.0.0",
  "description": "Production-ready Authentication & Security Module with Node.js, Express, TypeScript, and Prisma",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
