    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "keywords": ["auth", "jwt", "refresh-token-rotation", "express", "prisma", "typescript", "rbac"],
  "author": "",
  "license": "ISC",
