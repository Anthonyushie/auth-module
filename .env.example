# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/auth_db?schema=public"

# JWT Secrets (Use strong, randomly generated strings in production e.g. `openssl rand -base64 64`)
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"

# Token Expiration times (JWT format string)
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Refresh Token Expiry in Milliseconds for Cookie maxAge (7 days = 7 * 24 * 60 * 60 * 1000 = 604800000 ms)
REFRESH_TOKEN_COOKIE_MAX_AGE=604800000

# Password Hashing Salt Rounds
BCRYPT_SALT_ROUNDS=12

# Frontend URL (used for Flutterwave redirect_url + CORS)
FRONTEND_URL=http://localhost:3000

# Flutterwave (Test Mode — never commit live keys)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_PAYMENT_PLAN_ID=243392
FLW_WEBHOOK_SECRET_HASH=

# Single-tier subscription
SUBSCRIPTION_AMOUNT=5000
SUBSCRIPTION_CURRENCY=NGN
